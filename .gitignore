# Staging auth artifacts — contain signed session tokens, NEVER commit
# These files hold active session credentials equivalent to passwords.
# They are gitignored here AND excluded by the CI cleanup step (if: always()).
# EPRC-01 B3: the .txt variant was previously tracked (the rule below only
# covered .json). Broadened to all extensions + a defensive glob.
tests/performance/staging-auth-cookie.*
tests/performance/*-auth-cookie.*
tests/e2e/auth/staging-*.json
tests/e2e/auth/*-soak.json
/tmp/staging-soak.json
/tmp/prod-soak.json

# C2-R: un-approved preview route + design docs — kept LOCAL only, never promoted
# (removed from VCS after an auto-sync backup committed them against instructions)
app/(hr-admin)/admin-preview/
tests/roadmap/administration-ia-blueprint.md
tests/roadmap/c2r-navigation-rationalization.md

# Transient runtime lock files (not code)
.claude/scheduled_tasks.lock
.claude/*.lock

# HR data migration working set — contains REAL employee PII (names, emails, DOB,
# Oracle Fusion source workbooks, generated import files). NEVER commit to git.
hr_data_migration/

# Local UAT verification screenshots produced by scripts/uat-capture-approval-inbox.mjs.
# Raw browser evidence — local-only, may contain UAT-run data; never committed.
evidence/

# Local agent/runtime workspaces are not application source.
.claire/
.claude/launch.json

{
  "name": "avaniis-hr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--no-experimental-webstorage next dev --port 3000",
    "fresh": "rm -rf .next && NODE_OPTIONS=--no-experimental-webstorage next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/guard-db-write.js && drizzle-kit migrate",
    "db:push": "node scripts/guard-db-write.js && drizzle-kit push",
    "db:seed": "node scripts/guard-db-write.js && tsx drizzle/seed.ts",
    "db:seed:dev": "node scripts/guard-db-write.js && tsx drizzle/seeds/seed-dev.ts",
    "db:seed:prod": "node scripts/guard-db-write.js && tsx drizzle/seeds/seed-prod.ts",
    "db:reset:dev": "node scripts/guard-db-write.js && drizzle-kit migrate && tsx drizzle/seeds/seed-dev.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "node scripts/guard-db-write.js && playwright test",
    "prod:preflight": "tsx scripts/production-preflight.ts",
    "migration:preflight": "node scripts/migration-preflight.mjs",
    "migration:governance": "tsx scripts/migration-governance-report.ts",
    "perf:core-hr:smoke": "node scripts/core-hr-performance-smoke.mjs",
    "preview": "node scripts/start-preview.mjs",
    "db:seed:preview": "node scripts/guard-db-write.js && tsx drizzle/seeds/seed-preview.ts",
    "audit:branding": "python3 scripts/audit-branding.py",
    "db:prepare:preview": "node scripts/guard-db-write.js && node scripts/prepare-preview-schema.mjs",
    "check:styles": "node scripts/audit-react-styles.cjs",
    "preview:stable": "node scripts/start-preview.mjs --production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@auth/drizzle-adapter": "^1.4.0",
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/s3-request-presigner": "^3.1055.0",
    "@azure/communication-email": "^1.1.0",
    "@azure/storage-blob": "^12.31.0",
    "@internationalized/date": "^3.12.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.5.1",
    "@types/nodemailer": "^8.0.0",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "0.45.2",
    "html-to-image": "^1.11.11",
    "i18next": "^23.11.5",
    "i18next-resources-to-backend": "^1.2.1",
    "isomorphic-dompurify": "^3.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.400.0",
    "next": "15.3.9",
    "next-auth": "^5.0.0-beta.31",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "postgres": "^3.4.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^14.1.2",
    "tailwind-merge": "^2.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.44.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.5",
    "drizzle-kit": "0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.3.9",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.6",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.4.0"
}
